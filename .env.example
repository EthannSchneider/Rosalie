LOG_FILE="log.txt"

# Token Discord (Developer Portal > Bot). Active « Message Content Intent »
# ET « Server Members Intent » (pour retrouver un membre par son pseudo).
ROSALIE_TOKEN=""

# Les SEULES personnes à qui Rosalie obéit (IDs séparés par des virgules).
# Clic droit sur ton profil > Copier l'identifiant (mode développeur requis).
OWNER_IDS=""

# Salons où elle répond à tous tes messages (aussi activable avec /rosalie here)
ROSALIE_CHANNEL_IDS=""
# Mots qui l'appellent dans un message
ROSALIE_NAMES="rosalie"
# Tes messages commençant par ces préfixes sont ignorés
IGNORE_PREFIXES="//"

# Ollama
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"            # après fine-tune : rosalie
DECIDER_MODEL=""                   # modèle pour « dois-je répondre ? » (vide = même modèle)
EMBED_MODEL="nomic-embed-text"     # mémoire à long terme (274 Mo)
OLLAMA_KEEP_ALIVE="30m"
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.6

# Conversation
HISTORY_SIZE=30              # messages gardés par salon (mémoire courte)
CONVERSATION_TIMEOUT=180     # secondes pendant lesquelles elle te suit sans être nommée
USE_LLM_DECIDER=true
MAX_TOOL_STEPS=6             # nombre max d'actions enchaînées par message

# Internet (outils web_search et fetch_url)
WEB_ACCESS=true
WEB_SEARCH_PROVIDER="duckduckgo"   # duckduckgo (sans clé) | searxng | brave
SEARXNG_URL=""                     # ex: http://127.0.0.1:8080 si tu héberges SearXNG
BRAVE_API_KEY=""                   # https://brave.com/search/api (offre gratuite)
WEB_BROWSER="auto"                 # navigateur virtuel pour les sites en JavaScript : auto | always | never

PERSONA_FILE="personas/rosalie.md"
STORAGE_DIR="storages"
