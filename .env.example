# Ce fichier ne contient plus que le DÉMARRAGE. Tous les autres réglages (interfaces, token
# Discord, modèle, outils, personnalités…) sont dans storages/config.sqlite3 et se
# modifient avec :
#   - le site web     : http://127.0.0.1:8765 (comptes, réglages, chat)
#   - le terminal     : python bot.py settings · python bot.py users
# Un ancien .env complet est importé automatiquement au premier lancement (ensuite ses anciennes
# variables sont ignorées : tu peux les retirer).

LOG_FILE="log.txt"
STORAGE_DIR="storages"       # mémoire, souvenirs, agenda, réglages, comptes du site

# Où écoute le site web (interface « web »). 0.0.0.0 = joignable depuis le réseau : tout est
# derrière les comptes, mais préfère un reverse proxy HTTPS si tu l'ouvres hors de chez toi.
WEB_UI_HOST="127.0.0.1"
WEB_UI_PORT=8765
