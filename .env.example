LOG_FILE="log.txt"

# Token Discord (Developer Portal > Bot). Active « Message Content Intent »
# ET « Server Members Intent » (pour retrouver un membre par son pseudo).
ROSALIE_TOKEN=""

# Les SEULES personnes à qui Rosalie obéit (IDs séparés par des virgules).
# Clic droit sur ton profil > Copier l'identifiant (mode développeur requis).
OWNER_IDS=""

# Les autres personnes peuvent discuter avec elle (DM, mention, son nom) : réponses seulement,
# aucune action Discord, aucun accès à ses souvenirs. PUBLIC_COOLDOWN = délai anti-spam (s).
PUBLIC_REPLIES=true
PUBLIC_COOLDOWN=5

# Salons où elle répond à tous tes messages (aussi activable avec /rosalie here)
ROSALIE_CHANNEL_IDS=""
# Mots qui l'appellent dans un message
ROSALIE_NAMES="rosalie"
# Tes messages commençant par ces préfixes sont ignorés
IGNORE_PREFIXES="//"

# Ollama
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"            # après fine-tune : rosalie
DECIDER_MODEL=""                   # modèle pour « dois-je répondre ? » (vide = même modèle)
EMBED_MODEL="nomic-embed-text"     # mémoire à long terme (274 Mo)
OLLAMA_KEEP_ALIVE="30m"
OLLAMA_NUM_CTX=16384             # mémoire de travail (tokens) ; trop petit => réponses coupées
OLLAMA_TEMPERATURE=0.6

# Conversation
HISTORY_SIZE=30              # messages gardés par salon (mémoire courte)
CONVERSATION_TIMEOUT=180     # secondes pendant lesquelles elle te suit sans être nommée
USE_LLM_DECIDER=true
MAX_TOOL_STEPS=6             # nombre max d'actions enchaînées par message

# Internet (outils web_search et fetch_url)
WEB_ACCESS=true
WEB_SEARCH_PROVIDER="duckduckgo"   # duckduckgo (sans clé) | searxng | brave
SEARXNG_URL=""                     # ex: http://127.0.0.1:8080 si tu héberges SearXNG
BRAVE_API_KEY=""                   # https://brave.com/search/api (offre gratuite)
WEB_CONTACT=""                     # images Wikimedia Commons : leur règle exige un contact (e-mail ou URL)
WEB_BROWSER="auto"                 # navigateur virtuel pour les sites en JavaScript : auto | always | never

PERSONA_FILE="personas/rosalie.md"
STORAGE_DIR="storages"

# Exécution de code : elle écrit un bloc ```run-python / ```run-bash, tu le vois sur Discord
# et il ne tourne que si tu cliques « Exécuter ». Dossier de travail : storages/workspace.
CODE_EXEC=true
CODE_TIMEOUT=60              # secondes max par exécution
CODE_MAX_RUNS=3              # exécutions enchaînées max (ex : elle corrige une erreur)

# Rythme : elle attend que tu aies fini d'écrire (plusieurs messages, « écrit… ») avant de répondre
REPLY_DELAY=2                # secondes de calme après ton dernier message
REPLY_MAX_WAIT=20            # attente max avant de répondre quand même

# Heartbeat : un battement régulier qui déclenche ses relances programmées (plan_followup)
# et, de temps en temps, un « moment de réflexion » où elle peut t'écrire d'elle-même.
HEARTBEAT=true
HEARTBEAT_INTERVAL=60        # secondes entre deux battements
INITIATIVE=true              # écrire d'elle-même (aussi : /rosalie initiative)
INITIATIVE_EVERY=45          # minutes entre deux moments de réflexion
INITIATIVE_MIN_SILENCE=60    # minutes sans message avant qu'elle prenne l'initiative
INITIATIVE_MAX_PER_DAY=3     # messages spontanés max par 24 h
QUIET_HOURS="23-8"           # jamais d'initiative pendant ces heures (vide = aucune)
